rules_version = '2';
// Règles de sécurité Firestore — SistersMade.
// Principe : tout est INTERDIT sauf ce qui est explicitement autorisé ici.
// Chaque collection reçoit ses règles dans le ticket qui l'utilise.
service cloud.firestore {
  match /databases/{database}/documents {

    function estConnectee() { return request.auth != null; }
    function estElle(uid) { return estConnectee() && request.auth.uid == uid; }
    function pseudoValide(d) {
      return d.pseudo is string && d.pseudo.size() >= 2 && d.pseudo.size() <= 30;
    }

    // Profil de l'utilisatrice qui fait la requête (1 lecture facturée par appel).
    function monProfil() {
      return get(/databases/$(database)/documents/utilisatrices/$(request.auth.uid)).data;
    }

    // Mêmes règles que src/services/demandes.ts (À GARDER SYNCHRONISÉES).
    function demandeValide(d) {
      return d.titre is string && d.titre.size() >= 5 && d.titre.size() <= 80
        && d.description is string && d.description.size() >= 10 && d.description.size() <= 1000
        && d.categories is list && d.categories.size() >= 1 && d.categories.size() <= 2
        && d.categories.hasOnly(['pas_seule','paperasse','carriere','argent','numerique',
                                 'reparer','relais','apprendre','bouger','sortir'])
        && d.dureeEstimee in [0.5, 1, 1.5, 2, 3, 4, 8];
    }

    // ---- utilisatrices/{uid} (SM-10) ----
    match /utilisatrices/{uid} {
      // Lire un profil : toute utilisatrice connectée (pour afficher les pseudos).
      allow read: if estConnectee();

      // Créer : seulement SON profil, avec exactement les champs prévus,
      // un solde à 0, non vérifiée, et la date fixée par le SERVEUR.
      allow create: if estElle(uid)
        && request.resource.data.keys().hasOnly(['pseudo','bio','competences','commune','soldeHeures','verification','creeLe'])
        && request.resource.data.keys().hasAll(['pseudo','bio','competences','commune','soldeHeures','verification','creeLe'])
        && pseudoValide(request.resource.data)
        && request.resource.data.soldeHeures == 0
        && request.resource.data.verification == 'non_verifiee'
        && request.resource.data.creeLe == request.time;

      // Modifier : seulement SON profil, et jamais le solde, la vérification
      // ni la date de création. (L'échange QR aura sa propre règle, SM-19.)
      allow update: if estElle(uid)
        && pseudoValide(request.resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['soldeHeures','verification','creeLe']);

      allow delete: if false;
    }

    // ---- demandes/{id} (SM-14) ----
    match /demandes/{id} {
      // Lire : toute utilisatrice connectée (liste des demandes du quartier).
      allow read: if estConnectee();

      // Publier : en SON nom, sous SON pseudo, avec exactement les champs prévus,
      // ouverte, sans aidante, datée par le SERVEUR, et dans la limite du découvert.
      allow create: if estConnectee()
        && request.resource.data.keys().hasOnly(['autriceId','autricePseudo','titre','description','categories','dureeEstimee','commune','statut','aidanteId','creeLe'])
        && request.resource.data.keys().hasAll(['autriceId','autricePseudo','titre','description','categories','dureeEstimee','commune','statut','aidanteId','creeLe'])
        && request.resource.data.autriceId == request.auth.uid
        && request.resource.data.autricePseudo == monProfil().pseudo
        && demandeValide(request.resource.data)
        && request.resource.data.commune == null
        && request.resource.data.statut == 'ouverte'
        && request.resource.data.aidanteId == null
        && request.resource.data.creeLe == request.time
        // Crédit mutuel : solde - durée >= -2 h (DECOUVERT_MAX_HEURES)
        && monProfil().soldeHeures - request.resource.data.dureeEstimee >= -2;

      // « Je peux aider » (SM-24) : une AUTRE utilisatrice se propose sur une
      // demande encore ouverte et sans aidante. Seuls aidanteId et statut
      // changent, et elle ne peut inscrire QUE elle-même comme aidante.
      allow update: if estConnectee()
        && resource.data.statut == 'ouverte'
        && resource.data.aidanteId == null
        && resource.data.autriceId != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['aidanteId', 'statut'])
        && request.resource.data.aidanteId == request.auth.uid
        && request.resource.data.statut == 'en_cours';

      // Supprimer : pas encore (viendra avec « Mes demandes »).
      allow delete: if false;
    }
  }
}
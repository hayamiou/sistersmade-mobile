{
  "expo": {
    "name": "SistersMade",
    "slug": "tp-expo-muriel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-sistersmade.png",
    "scheme": "sistersmademobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon-sistersmade.png",
      "bundleIdentifier": "fr.cours.tpexpo.muriel",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "fr.cours.tpexpo.muriel"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FEFAF2",
          "image": "./assets/images/splash-sistersmade.png",
          "imageWidth": 240
        }
      ],
      "expo-background-task",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "SistersMade utilise l'appareil photo pour scanner le QR code qui valide un échange de temps entre deux membres.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SistersMade utilise ta position approximative pour trouver ta commune et te montrer les demandes d'entraide près de chez toi. Ta position exacte n'est jamais enregistrée.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false,
          "isIosReducedAccuracyByDefault": true,
          "locationFullAccuracyPermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "SistersMade utilise Face ID pour protéger l'accès à ton compte."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "SistersMade ajoute à ton agenda les rendez-vous d'entraide que tu acceptes, pour que tu ne les oublies pas.",
          "remindersPermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "ynov-webmobile",
    "extra": {
      "eas": {
        "projectId": "3bffded7-8e4b-4391-8b8a-cf3d1b53e378"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3bffded7-8e4b-4391-8b8a-cf3d1b53e378"
    }
  }
}
